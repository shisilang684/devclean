{
  "name": "devclean",
  "version": "0.2.0",
  "description": "Find and reclaim the gigabytes your dev tools are hoarding.",
  "type": "module",
  "bin": {
    "devclean": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
